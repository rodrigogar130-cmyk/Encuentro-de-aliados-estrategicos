# Servidor
PORT=3000
NODE_ENV=development
# Contraseña única para acceso /admin. CAMBIAR por contraseña robusta en producción.
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_LARGA_Y_UNICA
# El almacenamiento DEBE ser persistente en producción (volumen/disco, no temporal).
DATA_DIR=./data
# URL pública una vez publicado, e.g. https://aliados.empresa.com
PUBLIC_BASE_URL=http://localhost:3000
